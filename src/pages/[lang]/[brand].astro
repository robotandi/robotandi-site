---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { brands } from '../../data/brands';
import type { Lang } from '../../data/brands';
import { forms, ui } from '../../i18n';

export function getStaticPaths() {
  const paths = [];
  for (const lang of ['ar', 'en']) {
    for (const brand of brands) {
      paths.push({ params: { lang, brand: brand.slug }, props: { brand } });
    }
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const { brand } = Astro.props;
const t = ui[lang];
const f = forms[lang][brand.form];
---
<BaseLayout
  lang={lang}
  title={`${brand.title[lang]} | ${t.siteName}`}
  description={brand.summary[lang]}
  current={brand.slug}
  accent={brand.accent}
  path={brand.slug}
>
  <section class="brand-hero">
    <div class="container">
      <h1>{brand.title[lang]}</h1>
      <p>{brand.summary[lang]}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t.whatWeOffer}</h2>
      <div class="services">
        {brand.services[lang].map((sv) => (
          <div class="service">
            <h3>{sv.title}</h3>
            <p>{sv.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="form">
    <div class="container">
      <div class="form-wrap">
        <h2>{f.title}</h2>
        <p>{f.text}</p>
        <ContactForm lang={lang} kind={brand.form} source={brand.slug} />
      </div>
    </div>
  </section>
</BaseLayout>
