---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../data/brands';
import { ui } from '../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
---
<BaseLayout lang={lang} title={`${t.aboutTitle} | ${t.siteName}`} description={t.aboutP1} path="about">
  <div class="container page-title"><h1>{t.aboutTitle}</h1></div>
  <section class="section">
    <div class="container prose">
      <p>{t.aboutP1}</p>
      <p>{t.aboutP2}</p>
    </div>
  </section>
</BaseLayout>
