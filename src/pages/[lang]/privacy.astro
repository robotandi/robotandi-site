---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../data/brands';
import { ui } from '../../i18n';
import { privacy, privacyUpdated } from '../../data/privacy';
import { CONTACT_EMAIL } from '../../config';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const p = privacy[lang];
---
<BaseLayout lang={lang} title={`${p.title} | ${t.siteName}`} description={p.intro} path="privacy">
  <div class="container page-title"><h1>{p.title}</h1></div>
  <section class="section">
    <div class="container prose policy">
      <p class="updated">{privacyUpdated[lang]}</p>
      <p>{p.intro}</p>
      {p.sections.map((s) => (
        <>
          <h2>{s.title}</h2>
          {s.body.map((para) => <p>{para}</p>)}
        </>
      ))}
      <p class="policy-contact">
        <a href={`/${lang}/contact/`}>{t.contact}</a>
        {CONTACT_EMAIL && <> · {t.emailUs} <a href={`mailto:${CONTACT_EMAIL}`} dir="ltr">{CONTACT_EMAIL}</a></>}
      </p>
    </div>
  </section>
</BaseLayout>
